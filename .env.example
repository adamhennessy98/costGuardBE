# Local SQLite (default — no driver install needed)
# DATABASE_URL=sqlite:///./costguard.db

# Supabase PostgreSQL — paste your connection string from the Supabase dashboard
# The app auto-converts postgresql:// → postgresql+psycopg:// for psycopg v3
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

INVOICE_STORAGE_DIR=storage/invoices
